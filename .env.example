# Choose ONE provider (the app auto-detects whichever key is present)
# Priority order if multiple are set: OPENAI > ANTHROPIC > GEMINI

OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
# GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxx

# Model overrides (optional - sensible defaults are used otherwise)
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
GEMINI_MODEL=gemini-1.5-pro

# Backend
DATABASE_URL=sqlite:///./reconcile.db
BACKEND_URL=http://localhost:8000
ANOMALY_AMOUNT_THRESHOLD=50000
ANOMALY_ZSCORE_THRESHOLD=3.0
